---
// Fundo animado de arte generativa: linhas finas que seguem um "campo de fluxo"
// invisível, em movimento lento. Feito só com <canvas>, sem bibliotecas.
//
// - modo "forte": página inicial
// - modo "sutil": topo das páginas internas
// - pausa quando sai da tela ou quando a aba fica escondida
// - fica parado (imagem estática) para quem ativou "reduzir movimento"
// - as cores vêm de src/styles/tema.css (--color-arte-1, -2, -3)
interface Props {
  modo?: "forte" | "sutil";
  class?: string;
}
const { modo = "forte", class: classe = "" } = Astro.props;
---

<canvas class:list={["arte-generativa pointer-events-none", classe]} data-modo={modo} aria-hidden="true"></canvas>

<script>
  type Particula = { x: number; y: number; rastro: number[]; idade: number; vida: number; cor: number };

  const CONFIG = {
    forte: { densidade: 1 / 9000, maximo: 200, opacidade: 0.55, largura: 1.2, rastro: 70, velocidade: 1.1 },
    sutil: { densidade: 1 / 16000, maximo: 70, opacidade: 0.3, largura: 1, rastro: 50, velocidade: 0.8 },
  };
  const QUADROS_POR_SEGUNDO = 30; // suficiente para movimento lento e economiza bateria
  const movimentoReduzido = window.matchMedia("(prefers-reduced-motion: reduce)");

  function iniciar(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    const cfg = CONFIG[canvas.dataset.modo === "sutil" ? "sutil" : "forte"];
    const estilo = getComputedStyle(document.documentElement);
    const cores = ["--color-arte-1", "--color-arte-2", "--color-arte-3"].map(
      (v) => estilo.getPropertyValue(v).trim() || "#888888",
    );

    let largura = 0;
    let altura = 0;
    let particulas: Particula[] = [];
    let tempo = Math.random() * 10000;
    let visivel = false;
    let rodando = false;
    let ultimo = 0;

    // Direção do fluxo em cada ponto: soma de ondas suaves que muda devagar com o tempo
    const escala = 0.0022;
    const angulo = (x: number, y: number) =>
      (Math.sin(x * escala + tempo * 0.00011) +
        Math.cos(y * escala * 1.3 - tempo * 0.00009) +
        Math.sin((x + y) * escala * 0.55 + tempo * 0.00005)) *
      Math.PI *
      0.55;

    const nova = (): Particula => {
      const x = Math.random() * largura;
      const y = Math.random() * altura;
      return { x, y, rastro: [x, y], idade: 0, vida: 180 + Math.random() * 260, cor: Math.floor(Math.random() * 3) };
    };

    function ajustarTamanho() {
      const r = canvas.getBoundingClientRect();
      if (!r.width || !r.height) return;
      const dpr = Math.min(window.devicePixelRatio || 1, cfg === CONFIG.sutil ? 1 : 1.5);
      largura = r.width;
      altura = r.height;
      canvas.width = Math.round(largura * dpr);
      canvas.height = Math.round(altura * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      const quantidade = Math.min(cfg.maximo, Math.round(largura * altura * cfg.densidade));
      particulas = Array.from({ length: quantidade }, () => {
        const p = nova();
        p.idade = Math.random() * p.vida; // começam em momentos diferentes
        return p;
      });
    }

    function passo() {
      tempo += 1000 / QUADROS_POR_SEGUNDO;
      for (let i = 0; i < particulas.length; i++) {
        const p = particulas[i];
        const a = angulo(p.x, p.y);
        p.x += Math.cos(a) * cfg.velocidade;
        p.y += Math.sin(a) * cfg.velocidade;
        p.idade++;
        p.rastro.push(p.x, p.y);
        if (p.rastro.length > cfg.rastro * 2) p.rastro.splice(0, 2);
        const fora = p.x < -20 || p.y < -20 || p.x > largura + 20 || p.y > altura + 20;
        if (fora || p.idade > p.vida) particulas[i] = nova();
      }
    }

    function desenhar() {
      ctx!.clearRect(0, 0, largura, altura);
      ctx!.lineWidth = cfg.largura;
      ctx!.lineCap = "round";
      for (const p of particulas) {
        if (p.rastro.length < 4) continue;
        // surge e some devagar ao longo da vida
        const t = p.idade / p.vida;
        ctx!.globalAlpha = cfg.opacidade * Math.min(1, t * 5, (1 - t) * 5);
        ctx!.strokeStyle = cores[p.cor];
        ctx!.beginPath();
        ctx!.moveTo(p.rastro[0], p.rastro[1]);
        for (let j = 2; j < p.rastro.length; j += 2) ctx!.lineTo(p.rastro[j], p.rastro[j + 1]);
        ctx!.stroke();
      }
      ctx!.globalAlpha = 1;
    }

    function quadro(agora: number) {
      if (!rodando) return;
      if (agora - ultimo >= 1000 / QUADROS_POR_SEGUNDO - 2) {
        ultimo = agora;
        passo();
        desenhar();
      }
      requestAnimationFrame(quadro);
    }

    // Decide se anima, fica parado ou pausa
    function atualizar() {
      const deveRodar = visivel && !document.hidden && !movimentoReduzido.matches;
      if (deveRodar && !rodando) {
        rodando = true;
        requestAnimationFrame(quadro);
      } else if (!deveRodar) {
        rodando = false;
      }
    }

    function imagemParada() {
      for (let i = 0; i < cfg.rastro + 5; i++) passo();
      desenhar();
    }

    ajustarTamanho();
    imagemParada(); // primeira imagem aparece na hora, mesmo antes de animar

    new IntersectionObserver(([e]) => {
      visivel = e.isIntersecting;
      atualizar();
    }).observe(canvas);
    document.addEventListener("visibilitychange", atualizar);
    movimentoReduzido.addEventListener("change", () => {
      atualizar();
      if (movimentoReduzido.matches) imagemParada();
    });

    let espera: number | undefined;
    let larguraAnterior = canvas.getBoundingClientRect().width;
    new ResizeObserver(() => {
      // no celular a barra do navegador muda a altura ao rolar: só refaz se a largura mudar
      const w = canvas.getBoundingClientRect().width;
      if (Math.abs(w - larguraAnterior) < 2) return;
      larguraAnterior = w;
      clearTimeout(espera);
      espera = window.setTimeout(() => {
        ajustarTamanho();
        imagemParada();
      }, 200);
    }).observe(canvas);
  }

  document.querySelectorAll<HTMLCanvasElement>("canvas.arte-generativa").forEach(iniciar);
</script>
