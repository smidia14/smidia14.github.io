---
// Arte animada do topo, feita com os arcos do símbolo (código em src/lib/arte/).
// modo "forte": topo da página inicial | modo "sutil": topo das páginas internas
// O fundo (degradê) é feito em CSS por quem usa este componente; o canvas é transparente.
interface Props {
  modo?: "forte" | "sutil";
  class?: string;
}
const { modo = "forte", class: classe = "" } = Astro.props;
---

<canvas class:list={["arte-topo pointer-events-none block", classe]} data-modo={modo} aria-hidden="true"></canvas>

<script>
  import { iniciarArte } from "../lib/arte/motor";
  import { arcos } from "../lib/arte/arcos";

  document.querySelectorAll<HTMLCanvasElement>("canvas.arte-topo").forEach((canvas) => {
    iniciarArte(canvas, canvas.dataset.modo === "sutil" ? "sutil" : "forte", arcos);
  });
</script>
