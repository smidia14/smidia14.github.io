---
// Cabeçalho com o logo (símbolo + "SMI") e o menu principal. O menu vem de src/data/menu.json.
//
// Estados (controlados pelos atributos data-* e pelo script no fim do arquivo):
//  - data-sobre-arte="true": transparente por cima da faixa azul com arte, texto e logo brancos
//  - data-esconder-logo="true": só na página inicial, onde a intro já mostra o logo grande.
//    O logo do menu só aparece quando a intro sai INTEIRA da tela (data-intro-visivel="false"),
//    descendo para dentro da barra; some de novo ao voltar para a intro. Ele nunca fica
//    transparente nem deformado (manual, seção 5): só desliza, 100% opaco.
//  - data-rolado="true": a página rolou; ganha fundo azul, texto e logo brancos
// O logo nunca é animado nem fica transparente (manual, seção 5): ele só troca de versão
// (azul/branca) instantaneamente.
import { menu, contem } from "../lib/menu";
import Submenu from "./Submenu.astro";
import MenuCelular from "./MenuCelular.astro";
import { NOME_DO_SITE } from "../lib/site";

interface Props {
  atual: string; // endereço da página aberta (para destacar o item do menu)
  sobreArte?: boolean; // cabeçalho transparente, com texto claro, por cima da faixa azul com arte
  esconderLogoNoTopo?: boolean; // página inicial: o logo só aparece depois de rolar
}
const { atual, sobreArte = false, esconderLogoNoTopo = false } = Astro.props;
---

<header
  id="cabecalho"
  data-sobre-arte={sobreArte ? "true" : "false"}
  data-esconder-logo={esconderLogoNoTopo ? "true" : "false"}
  data-intro-visivel={esconderLogoNoTopo ? "true" : "false"}
  data-rolado="false"
  class:list={[
    "group/cab inset-x-0 top-0 z-30 text-azul transition-[background-color,box-shadow] duration-300",
    "data-[sobre-arte=true]:text-branco data-[rolado=true]:bg-azul data-[rolado=true]:text-branco data-[rolado=true]:shadow-lg data-[rolado=true]:shadow-azul-escuro/20",
    sobreArte ? "fixed" : "sticky",
  ]}
>
  <!-- computador: 3 colunas (logo | menu no centro | espaço igual) para o menu ficar no meio -->
  <div class="mx-auto flex max-w-site items-center justify-between gap-8 px-4 py-3.5 sm:px-8 xl:grid xl:grid-cols-[1fr_auto_1fr]">
    <!-- logo com área de segurança (margem livre em volta) -->
    <a href="/" class="logo-cabecalho shrink-0 overflow-hidden p-1.5 xl:justify-self-start" aria-label={`${NOME_DO_SITE} — página inicial`}>
      <img
        src="/marca/smi-horizontal-azul.svg"
        alt=""
        width="164"
        height="72"
        class="h-9 w-auto group-data-[rolado=true]/cab:hidden group-data-[sobre-arte=true]/cab:hidden sm:h-10"
      />
      <img
        src="/marca/smi-horizontal-branco.svg"
        alt=""
        width="164"
        height="72"
        class="hidden h-9 w-auto group-data-[rolado=true]/cab:block group-data-[sobre-arte=true]/cab:block sm:h-10"
      />
    </a>

    <!-- Computador: menu na linha, subitens aparecem ao passar o mouse ou com a tecla Tab -->
    <nav aria-label="Menu principal" class="hidden xl:block">
      <ul class="flex items-center">
        {
          menu.map((item, i) => (
            <li class="group relative">
              <a
                href={item.href}
                aria-current={item.href === atual ? "page" : undefined}
                class:list={[
                  "block px-2.5 py-2 font-informativo text-[0.9rem] font-semibold whitespace-nowrap decoration-2 underline-offset-8",
                  // item ativo: fio dourado embaixo; ao passar o mouse: fio verde (detalhes, manual seção 2)
                  contem(item, atual) ? "underline decoration-dourado" : "hover:underline hover:decoration-verde",
                ]}
              >
                {item.titulo}
              </a>
              {item.filhos.length > 0 && (
                <div
                  class:list={[
                    "invisible absolute top-full z-40 pt-2 opacity-0 transition-all duration-200 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100",
                    i >= menu.length - 3 ? "right-0" : "left-0",
                  ]}
                >
                  <div class="max-h-[75vh] w-72 overflow-y-auto rounded-lg border-t-2 border-dourado bg-superficie p-3 text-texto shadow-xl shadow-azul-escuro/15">
                    <Submenu itens={item.filhos} atual={atual} />
                  </div>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Celular e tablet: botão que abre o menu em tela cheia -->
    <button
      type="button"
      id="abrir-menu"
      aria-controls="menu-celular"
      aria-expanded="false"
      class="flex items-center gap-2 rounded-full border border-current/40 px-4 py-2 font-informativo text-sm font-semibold xl:hidden"
    >
      <svg class="size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M3 6h14M3 10h14M3 14h14" />
      </svg>
      Menu
    </button>
  </div>

  <div id="menu-celular" hidden class="fixed inset-0 z-50 overflow-y-auto bg-fundo text-texto xl:hidden">
    <div class="mx-auto max-w-xl px-6 pt-4 pb-16">
      <div class="mb-6 flex items-center justify-between gap-6">
        <span class="p-1.5"><img src="/marca/smi-horizontal-azul.svg" alt={NOME_DO_SITE} width="164" height="72" class="h-9 w-auto" /></span>
        <button type="button" id="fechar-menu" class="rounded-full border border-linha px-4 py-2 font-informativo text-sm font-semibold text-azul">
          Fechar
        </button>
      </div>
      <nav aria-label="Menu principal">
        <MenuCelular itens={menu} atual={atual} />
      </nav>
    </div>
  </div>
</header>

<script>
  // Fundo azul quando a página rola
  const cabecalho = document.getElementById("cabecalho")!;
  const atualizarRolagem = () => (cabecalho.dataset.rolado = String(window.scrollY > 12));
  atualizarRolagem();
  window.addEventListener("scroll", atualizarRolagem, { passive: true });

  // Página inicial: o logo do menu só aparece quando a intro sai inteira da tela
  const intro = document.querySelector("[data-intro]");
  if (intro && cabecalho.dataset.esconderLogo === "true") {
    new IntersectionObserver(([e]) => (cabecalho.dataset.introVisivel = String(e.isIntersecting))).observe(intro);
  }

  const painel = document.getElementById("menu-celular")!;
  const abrir = document.getElementById("abrir-menu")!;
  const fechar = document.getElementById("fechar-menu")!;

  function mostrar(sim: boolean) {
    painel.hidden = !sim;
    abrir.setAttribute("aria-expanded", String(sim));
    document.documentElement.style.overflow = sim ? "hidden" : "";
    (sim ? fechar : abrir).focus();
  }
  abrir.addEventListener("click", () => mostrar(true));
  fechar.addEventListener("click", () => mostrar(false));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !painel.hidden) mostrar(false);
  });

  // Botões que abrem/fecham os subitens
  painel.querySelectorAll<HTMLButtonElement>("[data-alternar]").forEach((botao) => {
    const lista = botao.closest("li")!.querySelector<HTMLElement>(":scope > div[hidden], :scope > div:not(.flex)")!;
    const girar = () => botao.querySelector("svg")!.classList.toggle("rotate-180", botao.ariaExpanded === "true");
    girar();
    botao.addEventListener("click", () => {
      const aberto = botao.getAttribute("aria-expanded") === "true";
      botao.setAttribute("aria-expanded", String(!aberto));
      lista.hidden = aberto;
      girar();
    });
  });
</script>
