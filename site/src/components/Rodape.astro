---
// Rodapé: fundo azul com a textura sutil da Trama 2, logo com o nome completo (branco sobre
// azul, combinação permitida pelo manual), links principais do menu, o link do Arquivo e o
// contato/itens da barra lateral do site antigo.
import { getEntry, render } from "astro:content";
import { NOME_DO_SITE } from "../lib/site";
import { menu } from "../lib/menu";
import contatos from "../data/contatos.json"; // editável pelo painel

interface Props {
  colado?: boolean; // páginas internas: sem espaço em branco acima (encosta na área cinza)
}
const { colado = false } = Astro.props;

const lateral = await getEntry("blocos", "barra-lateral");
const rodape = await getEntry("blocos", "rodape");
const { Content: Lateral } = lateral ? await render(lateral) : { Content: null };
const { Content: TextoRodape } = rodape ? await render(rodape) : { Content: null };
const principais = menu.filter((item) => item.href !== "/");

// redes sociais preenchidas no painel (as em branco não aparecem)
const NOMES_REDES: Record<string, string> = { youtube: "YouTube", instagram: "Instagram", facebook: "Facebook", whatsapp: "WhatsApp" };
const redes = Object.entries(contatos.redes)
  .filter(([, link]) => link.trim())
  .map(([rede, link]) => ({ chave: rede, nome: NOMES_REDES[rede] ?? rede, link: rede === "whatsapp" && !link.startsWith("http") ? `https://wa.me/${link.replace(/\D/g, "")}` : link }));
const { escritorio } = contatos;
// ícones (formas simples das marcas, em uma cor só)
const ICONES_REDES: Record<string, string> = {
  youtube:
    "M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8ZM9.8 15.1V8.9l5.4 3.1-5.4 3.1Z",
  instagram:
    "M12 2.2c3.2 0 3.6 0 4.8.1 3.3.1 4.8 1.7 4.9 4.9.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 3.2-1.7 4.8-4.9 4.9-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-3.3-.1-4.8-1.7-4.9-4.9C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8C2.4 3.9 3.9 2.4 7.2 2.3 8.4 2.2 8.8 2.2 12 2.2Zm0 4.8a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4Zm5.2-9.6a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4Z",
  facebook: "M14 8.5V6.8c0-.8.2-1.3 1.4-1.3H17V2.6c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v1.7H7.5v3.3h2.8V22H14V11.8h2.8l.4-3.3H14Z",
  whatsapp:
    "M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1l-.9 1.1c-.2.2-.3.2-.6.1a8 8 0 0 1-2.4-1.5 9 9 0 0 1-1.6-2c-.2-.3 0-.5.1-.6l.5-.5.3-.5v-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.2 5 4.5 2.5 1 3 .8 3.6.7.5-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.3ZM12 21.8a9.8 9.8 0 0 1-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A9.8 9.8 0 1 1 12 21.8Zm0-21.6A11.8 11.8 0 0 0 1.8 17.9L.1 24l6.3-1.6A11.8 11.8 0 1 0 12 .2Z",
};
---

<footer class:list={["trama trama-clara bg-azul text-branco", !colado && "mt-32"]}>
  <div class="mx-auto grid max-w-site gap-12 px-5 py-16 sm:px-8 md:grid-cols-2 lg:grid-cols-[1.1fr_0.9fr_1.6fr] lg:gap-14">
    <div>
      <!-- logo com área de segurança (margem livre em volta) -->
      <div class="-m-3 inline-block p-3">
        <img
          src="/marca/nome-completo-horizontal-branco.svg"
          alt={NOME_DO_SITE}
          width="310"
          height="110"
          class="h-auto w-64 sm:w-72"
          loading="lazy"
        />
      </div>
      {TextoRodape && <div class="mt-8 font-informativo text-sm text-azul-claro"><TextoRodape /></div>}
      <span class="mt-8 block h-0.5 w-10 bg-dourado" aria-hidden="true"></span>
    </div>

    <nav aria-label="Links principais">
      <ul class="space-y-2.5 font-informativo text-[0.95rem] font-semibold">
        {
          principais.map((item) => (
            <li>
              <a href={item.href} class="underline decoration-transparent decoration-2 underline-offset-4 hover:decoration-verde">
                {item.titulo}
              </a>
            </li>
          ))
        }
        <li class="pt-3">
          <a href="/arquivo/" class="underline decoration-verde decoration-2 underline-offset-4 hover:decoration-dourado">Arquivo</a>
        </li>
        <!-- entrada do painel de administração da equipe (/admin/) -->
        <li class="pt-3">
          <a
            href="/admin/"
            class="text-sm text-azul-claro underline decoration-transparent decoration-2 underline-offset-4 hover:decoration-verde"
          >
            Área da equipe
          </a>
        </li>
      </ul>
    </nav>

    <div class="rodape-texto prose prose-sm max-w-none md:col-span-2 lg:col-span-1 sm:columns-2 sm:gap-10 [&_h2]:mt-0 [&_h2]:break-after-avoid [&_img]:ml-0 [&_img]:max-h-28">
      {Lateral && <Lateral />}
      <!-- contato e redes: vêm de src/data/contatos.json (painel) -->
      <h2>Contato</h2>
      <p>
        <strong>{escritorio.titulo}</strong>
      </p>
      {escritorio.endereco && <p class="whitespace-pre-line">{escritorio.endereco}</p>}
      {escritorio.telefone && <p>{escritorio.telefone}</p>}
      {
        contatos.emails.filter(Boolean).map((email) => (
          <p>
            <a href={`mailto:${email}`}>{email}</a>
          </p>
        ))
      }
      {
        redes.length > 0 && (
          <p class="not-prose mt-5 flex flex-wrap gap-2">
            {redes.map((r) => (
              <a href={r.link} target="_blank" rel="noopener" class="rede-social" aria-label={r.nome} title={r.nome}>
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                  <path d={ICONES_REDES[r.chave]} />
                </svg>
              </a>
            ))}
          </p>
        )
      }
    </div>
  </div>
</footer>

<style>
  /* textos do rodapé sobre o azul: branco e azul claro (contraste 8,8 e 5,7 : 1) */
  .rodape-texto {
    --tw-prose-body: var(--color-azul-claro);
    --tw-prose-headings: var(--color-branco);
    --tw-prose-bold: var(--color-branco);
    --tw-prose-links: var(--color-branco);
    overflow-wrap: anywhere;
  }
  .rodape-texto :global(h2) {
    font-family: var(--font-titulo);
    font-weight: 500;
  }
  .rede-social {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.1);
    color: var(--color-branco);
    transition: background-color 0.2s ease;
  }
  .rede-social:hover {
    background: var(--color-verde);
  }
  .rede-social svg {
    width: 1.2rem;
    height: 1.2rem;
  }
  .rodape-texto :global(img) {
    display: inline-block;
    width: auto;
    border-radius: 6px;
  }
</style>
