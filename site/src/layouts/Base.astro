---
// Estrutura comum de todas as páginas: <head>, cabeçalho, conteúdo e rodapé.
import "../styles/global.css";
import Cabecalho from "../components/Cabecalho.astro";
import Rodape from "../components/Rodape.astro";
import { NOME_DO_SITE } from "../lib/site";

interface Props {
  titulo: string; // título desta página
  descricao: string; // descrição (aparece no Google); "PENDENTE" enquanto não houver
  atual: string; // endereço desta página
  cabecalhoSobreArte?: boolean; // página inicial: menu transparente por cima da arte
}
const { titulo, descricao, atual, cabecalhoSobreArte = false } = Astro.props;
const tituloCompleto = titulo === NOME_DO_SITE ? titulo : `${titulo} · ${NOME_DO_SITE}`;
---

<!doctype html>
<html lang="pt-BR" class="sem-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      document.documentElement.classList.remove("sem-js");
    </script>
  </head>
  <body class="flex min-h-svh flex-col antialiased">
    <Cabecalho atual={atual} sobreArte={cabecalhoSobreArte} />
    <main class="flex-1">
      <slot />
    </main>
    <Rodape />

    <script>
      // Elementos com a classe "surgir" aparecem suavemente quando entram na tela
      const observador = new IntersectionObserver(
        (entradas) => {
          for (const e of entradas) {
            if (e.isIntersecting) {
              e.target.classList.add("visivel");
              observador.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -8% 0px" },
      );
      document.querySelectorAll(".surgir").forEach((el) => observador.observe(el));
    </script>
  </body>
</html>
