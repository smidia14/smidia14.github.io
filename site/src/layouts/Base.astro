---
// Estrutura comum de todas as páginas: <head>, cabeçalho, conteúdo e rodapé.
import "../styles/global.css";
import Cabecalho from "../components/Cabecalho.astro";
import Rodape from "../components/Rodape.astro";
import { NOME_DO_SITE } from "../lib/site";

interface Props {
  titulo: string; // título desta página
  descricao: string; // descrição (aparece no Google); "PENDENTE" enquanto não houver
  atual: string; // endereço desta página
  cabecalhoSobreArte?: boolean; // menu transparente por cima da faixa azul com arte
  esconderLogoNoTopo?: boolean; // só na página inicial (o topo já mostra o logo grande)
  rodapeColado?: boolean; // páginas internas: o rodapé encosta na área cinza de leitura
}
const { titulo, descricao, atual, cabecalhoSobreArte = false, esconderLogoNoTopo = false, rodapeColado = false } = Astro.props;
const tituloCompleto = titulo === NOME_DO_SITE ? titulo : `${titulo} · ${NOME_DO_SITE}`;
// imagem de compartilhamento (WhatsApp/redes): precisa do endereço completo
const imagemCompartilhar = new URL("/compartilhar.jpg", Astro.site).href;
const enderecoCompleto = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="pt-BR" class="sem-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#154d7d" />
    <!-- compartilhamento (WhatsApp, Facebook, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NOME_DO_SITE} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={enderecoCompleto} />
    <meta property="og:image" content={imagemCompartilhar} />
    <meta property="og:image:width" content="640" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="Logo da SMI" />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      document.documentElement.classList.remove("sem-js");
    </script>
  </head>
  <body class="flex min-h-svh flex-col antialiased">
    <Cabecalho atual={atual} sobreArte={cabecalhoSobreArte} esconderLogoNoTopo={esconderLogoNoTopo} />
    <main class="flex-1">
      <slot />
    </main>
    <Rodape colado={rodapeColado} />

    <script>
      // Elementos com a classe "surgir" aparecem suavemente quando entram na tela
      const observador = new IntersectionObserver(
        (entradas) => {
          for (const e of entradas) {
            if (e.isIntersecting) {
              e.target.classList.add("visivel");
              observador.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -8% 0px" },
      );
      document.querySelectorAll(".surgir").forEach((el) => observador.observe(el));
    </script>
  </body>
</html>
