---
// Todas as páginas de conteúdo (tudo menos a página inicial e o Arquivo).
// O visual vem do molde src/layouts/MoldeInterno.astro.
//  - Páginas que vieram do site antigo: src/content/paginas/*.md
//  - Páginas criadas ou editadas pelo painel: src/data/paginas/*.json (o texto do painel
//    substitui o antigo quando a página é a mesma).
//  - Abas desativadas no painel não são publicadas.
import { getCollection, render } from "astro:content";
import MoldeInterno from "../layouts/MoldeInterno.astro";
import Biblioteca from "../components/Biblioteca.astro";
import AoVivo from "../components/AoVivo.astro";
import CatalogoIgrejas from "../components/CatalogoIgrejas.astro";
import { menu, trilhaNoMenu, desativadas, type ItemMenu } from "../lib/menu";
import { paginasPainel, paginaPainel, htmlLimpo, type PaginaPainel } from "../lib/paginas-painel";

interface DadosPagina {
  titulo: string;
  descricao: string;
  rota: string;
  esta_no_menu: boolean;
}

export async function getStaticPaths() {
  const antigas = await getCollection("paginas", (p) => p.data.rota !== "");
  const rotasAntigas = new Set(antigas.map((p) => p.data.rota));
  const caminhos = [
    ...antigas.map((pagina) => ({ params: { rota: pagina.data.rota }, props: { pagina, painel: paginaPainel(pagina.data.rota) } })),
    // páginas novas, criadas no painel
    ...paginasPainel.filter((p) => !rotasAntigas.has(p.rota)).map((painel) => ({ params: { rota: painel.rota }, props: { pagina: null, painel } })),
  ];
  return caminhos.filter((c) => !desativadas.has(`/${c.params.rota}/`));
}

const { pagina, painel } = Astro.props as { pagina: Awaited<ReturnType<typeof getCollection<"paginas">>>[number] | null; painel?: PaginaPainel };
const Content = pagina && !painel ? (await render(pagina)).Content : null;
const dados: DadosPagina = painel
  ? { titulo: painel.titulo, descricao: painel.descricao || "PENDENTE", rota: painel.rota, esta_no_menu: true }
  : { ...pagina!.data };
const href = `/${dados.rota}/`;
const temTexto = painel ? !!painel.html?.replace(/<[^>]*>|&nbsp;|\s/g, "") : !!pagina?.body?.trim();

// Migalhas ("Página inicial › Doutrinas › ...")
function trilha(): ItemMenu[] {
  const inicio = menu[0];
  if (dados.esta_no_menu) return [inicio, ...trilhaNoMenu(href)].filter((x, i, a) => a.indexOf(x) === i);
  if (dados.rota.startsWith("arquivo/"))
    return [inicio, { titulo: "Arquivo", href: "/arquivo/", filhos: [] }, { titulo: dados.titulo, href, filhos: [] }];
  // páginas 2, 3... de galerias: ficam abaixo da página "mãe"
  const partes = dados.rota.split("/");
  for (let i = partes.length - 1; i > 0; i--) {
    const mae = trilhaNoMenu(`/${partes.slice(0, i).join("/")}/`);
    if (mae.length) return [inicio, ...mae, { titulo: dados.titulo, href, filhos: [] }];
  }
  return [inicio, { titulo: dados.titulo, href, filhos: [] }];
}
---

<MoldeInterno titulo={dados.titulo} descricao={dados.descricao} atual={href} trilha={trilha()}>
  <!-- materiais da biblioteca de PDFs (só nas páginas que têm; veja src/lib/biblioteca.ts) -->
  <Biblioteca href={href} temTexto={temTexto} />
  {href === "/transmissoes-ao-vivo/" && <AoVivo />}
  {href === "/contatos/" && <CatalogoIgrejas />}

  <div class="texto prose prose-lg mx-auto max-w-[68ch]">
    {painel ? <Fragment set:html={htmlLimpo(painel.html)} /> : Content && <Content />}
  </div>

</MoldeInterno>
