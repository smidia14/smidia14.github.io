---
// Arquivo: páginas do site antigo que não estão no menu (antigas notícias, etc.).
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ArteGenerativa from "../../components/ArteGenerativa.astro";

const fora = await getCollection("paginas", (p) => !p.data.esta_no_menu);

// Agrupa pelo começo do endereço antigo: /news/, /products/, /departamento/...
const grupos = new Map<string, typeof fora>();
for (const p of fora.sort((a, b) => a.data.titulo.localeCompare(b.data.titulo, "pt-BR"))) {
  const inicio = "/" + decodeURI(new URL(p.data.url_original).pathname).split("/")[1] + "/";
  grupos.set(inicio, [...(grupos.get(inicio) ?? []), p]);
}
---

<Base titulo="Arquivo" descricao="PENDENTE" atual="/arquivo/">
  <section class="relative">
    <ArteGenerativa
      modo="sutil"
      class="absolute inset-x-0 -top-24 h-[26rem] w-full [mask-image:linear-gradient(to_bottom,black_30%,transparent)]"
    />
    <div class="relative mx-auto max-w-3xl px-5 pt-12 pb-10 sm:px-8 sm:pt-20">
      <h1 class="surgir font-titulo text-4xl leading-[1.08] font-medium tracking-tight sm:text-6xl">Arquivo</h1>
      <p class="surgir mt-6 text-suave">PENDENTE</p>
    </div>
  </section>

  <div class="mx-auto max-w-3xl space-y-14 px-5 sm:px-8">
    {
      [...grupos].map(([inicio, paginas]) => (
        <section class="surgir">
          <h2 class="font-mono text-sm text-suave">{inicio}</h2>
          <ul class="mt-3 divide-y divide-linha border-y border-linha">
            {paginas.map((p) => (
              <li>
                <a href={`/${p.data.rota}/`} class="group flex items-baseline justify-between gap-4 py-4 hover:text-destaque">
                  <span class="font-titulo text-xl">{p.data.titulo}</span>
                  <span class="shrink-0 text-xs text-suave">{decodeURI(new URL(p.data.url_original).pathname)}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
