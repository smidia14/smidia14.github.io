---
// Arquivo: páginas do site antigo que não estão no menu (antigas notícias, etc.).
// Usa o mesmo molde das páginas internas.
import { getCollection } from "astro:content";
import MoldeInterno from "../../layouts/MoldeInterno.astro";
import { menu } from "../../lib/menu";

const fora = await getCollection("paginas", (p) => !p.data.esta_no_menu);

// Agrupa pelo começo do endereço antigo: /news/, /products/, /departamento/...
const grupos = new Map<string, typeof fora>();
for (const p of fora.sort((a, b) => a.data.titulo.localeCompare(b.data.titulo, "pt-BR"))) {
  const inicio = "/" + decodeURI(new URL(p.data.url_original).pathname).split("/")[1] + "/";
  grupos.set(inicio, [...(grupos.get(inicio) ?? []), p]);
}
---

<MoldeInterno titulo="Arquivo" descricao="PENDENTE" atual="/arquivo/" trilha={[menu[0], { titulo: "Arquivo", href: "/arquivo/" }]}>
  <div class="mx-auto max-w-[68ch] space-y-12">
    {
      [...grupos].map(([inicio, paginas]) => (
        <section>
          <h2 class="font-mono text-sm text-suave">{inicio}</h2>
          <ul class="mt-3 divide-y divide-linha border-y border-linha">
            {paginas.map((p) => (
              <li>
                <a href={`/${p.data.rota}/`} class="group flex flex-col gap-1 py-4 text-azul hover:text-azul-escuro sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                  <span class="font-titulo text-xl">{p.data.titulo}</span>
                  <!-- endereço antigo: no celular fica embaixo e pode quebrar linha -->
                  <span class="text-xs break-all text-suave sm:shrink-0 sm:text-right">{decodeURI(new URL(p.data.url_original).pathname)}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</MoldeInterno>
