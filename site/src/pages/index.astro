---
// Página inicial: arte generativa em destaque + conteúdo da página inicial do site antigo.
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import ArteGenerativa from "../components/ArteGenerativa.astro";
import { menu } from "../lib/menu";
import { NOME_DO_SITE } from "../lib/site";

const inicio = await getEntry("paginas", "inicio");
if (!inicio) throw new Error("Página inicial não encontrada. Rode: npm run importar");
const { Content } = await render(inicio);
const coluna = await getEntry("blocos", "coluna-esquerda");
const { Content: Coluna } = coluna ? await render(coluna) : { Content: null };
const secoes = menu.filter((item) => item.href !== "/");
---

<Base titulo={NOME_DO_SITE} descricao={inicio.data.descricao} atual="/">
  <section class="relative -mt-[76px] flex min-h-[88svh] items-end overflow-hidden pt-[76px]">
    <ArteGenerativa modo="forte" class="absolute inset-0 h-full w-full" />
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-fundo"></div>
    <div class="relative mx-auto w-full max-w-7xl px-5 pb-16 sm:px-8 sm:pb-24">
      <h1 class="surgir max-w-4xl font-titulo text-5xl leading-[1.02] font-medium tracking-tight text-balance sm:text-7xl lg:text-8xl">
        {NOME_DO_SITE}
      </h1>
    </div>
  </section>

  <!-- Atalhos para as seções do menu -->
  <nav aria-label="Seções do site" class="mx-auto max-w-7xl px-5 sm:px-8">
    <ul class="grid border-t border-linha sm:grid-cols-2 lg:grid-cols-4">
      {
        secoes.map((item) => (
          <li class="surgir border-b border-linha">
            <a href={item.href} class="group flex h-full items-center justify-between gap-4 py-6 pr-6 font-titulo text-xl hover:text-destaque sm:text-2xl">
              {item.titulo}
              <span aria-hidden="true" class="text-suave transition-transform group-hover:translate-x-1 group-hover:text-destaque">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <article class="surgir texto prose prose-lg mx-auto mt-24 max-w-4xl px-5 text-center sm:px-8">
    <Content />
  </article>

  {
    Coluna && (
      <aside class="surgir texto prose mx-auto mt-16 max-w-4xl px-5 text-center sm:px-8">
        <Coluna />
      </aside>
    )
  }
</Base>
