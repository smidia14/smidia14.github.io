---
// Página inicial: arte generativa em destaque + conteúdo da página inicial do site antigo.
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import ArteTopo from "../components/ArteTopo.astro";
import { menu } from "../lib/menu";
import { NOME_DO_SITE } from "../lib/site";

const inicio = await getEntry("paginas", "inicio");
if (!inicio) throw new Error("Página inicial não encontrada. Rode: npm run importar");
const { Content } = await render(inicio);
const coluna = await getEntry("blocos", "coluna-esquerda");
const { Content: Coluna } = coluna ? await render(coluna) : { Content: null };
const secoes = menu.filter((item) => item.href !== "/");
---

<Base titulo={NOME_DO_SITE} descricao={inicio.data.descricao} atual="/" cabecalhoSobreArte>
  <!-- Topo ocupando a tela: arte animada ao fundo, título por cima, menu transparente -->
  <section
    class="relative flex h-svh min-h-[34rem] items-end overflow-hidden bg-gradient-to-b from-principal-escuro to-principal text-claro"
  >
    <ArteTopo modo="forte" class="absolute inset-0 h-full w-full" />
    <!-- véu escuro discreto atrás do título, para a leitura nunca depender da arte -->
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-principal-escuro/70 to-transparent"></div>
    <div class="relative mx-auto w-full max-w-7xl px-5 pb-20 sm:px-8 sm:pb-28">
      <span class="surgir mb-8 block h-px w-16 bg-dourado" aria-hidden="true"></span>
      <h1 class="surgir max-w-4xl font-titulo text-5xl leading-[1.02] font-light tracking-tight text-balance sm:text-7xl lg:text-8xl">
        {NOME_DO_SITE}
      </h1>
    </div>
  </section>

  <!-- Atalhos para as seções do menu -->
  <nav aria-label="Seções do site" class="mx-auto max-w-7xl px-5 sm:px-8">
    <ul class="grid sm:grid-cols-2 lg:grid-cols-4">
      {
        secoes.map((item) => (
          <li class="surgir border-b border-linha">
            <a href={item.href} class="group flex h-full items-center justify-between gap-4 py-6 pr-6 font-titulo text-xl text-principal hover:text-link sm:text-2xl">
              {item.titulo}
              <span aria-hidden="true" class="text-dourado transition-transform group-hover:translate-x-1">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <article class="surgir texto prose prose-lg mx-auto mt-24 max-w-4xl px-5 text-center sm:px-8">
    <Content />
  </article>

  {
    Coluna && (
      <aside class="surgir texto prose mx-auto mt-16 max-w-4xl px-5 text-center sm:px-8">
        <Coluna />
      </aside>
    )
  }
</Base>
